# Configuração de Ambiente - Portal MCM
# Copie este arquivo para .env e ajuste conforme necessário

################################################################################
# BANCO DE DADOS
################################################################################

# Host do banco de dados
DB_HOST=localhost

# Porta do MySQL
DB_PORT=3306

# Nome do banco de dados
DB_NAME=portalmcm_db

# Usuário do banco de dados
DB_USER=portalmcm_user

# Senha do banco de dados
# IMPORTANTE: Use uma senha forte em produção!
DB_PASSWORD=CHANGE_ME

# Charset do banco
DB_CHARSET=utf8mb4

################################################################################
# APLICAÇÃO
################################################################################

# Nome da aplicação
APP_NAME=Portal MCM

# Versão
APP_VERSION=1.0.0

# Ambiente (development, production)
APP_ENV=development

# Debug (true, false)
APP_DEBUG=false

# URL base da aplicação
APP_URL=http://portalmcm.local

# Caminho do projeto
APP_PATH=/var/www/portalmcm

################################################################################
# SEGURANÇA
################################################################################

# Chave de criptografia (32 caracteres aleatórios)
APP_KEY=ChangeThisToARandomString32Chars

# Hash para senhas
PASSWORD_HASH_ALGO=bcrypt

# Sessão
SESSION_DRIVER=file
SESSION_TIMEOUT=3600

# CORS (para API)
CORS_ALLOWED_ORIGINS=http://portalmcm.local,http://localhost

################################################################################
# EMAIL (OPCIONAL)
################################################################################

# Driver de email (file, smtp, sendmail)
MAIL_DRIVER=file

# Host SMTP
MAIL_HOST=smtp.mailtrap.io

# Porta SMTP
MAIL_PORT=465

# Email de envio
MAIL_FROM=noreply@portalmcm.local

# Usuário SMTP
MAIL_USERNAME=seu_usuario

# Senha SMTP
MAIL_PASSWORD=sua_senha

################################################################################
# UPLOAD DE ARQUIVOS
################################################################################

# Diretório de uploads
UPLOAD_DIR=uploads

# Tamanho máximo de upload (em MB)
MAX_UPLOAD_SIZE=50

# Extensões permitidas (separadas por vírgula)
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,txt

################################################################################
# IA
################################################################################

# IA ativada (true, false)
AI_ENABLED=true

# Modo debug da IA
AI_DEBUG=false

# Confiança mínima para respostas (0.0 a 1.0)
AI_MIN_CONFIDENCE=0.3

# Número máximo de documentos para análise
AI_MAX_DOCUMENTS=5

# Cache de respostas (true, false)
AI_CACHE_ENABLED=true

# TTL do cache em segundos
AI_CACHE_TTL=3600

################################################################################
# LOGS
################################################################################

# Diretório de logs
LOG_DIR=logs

# Nível de log (debug, info, warning, error)
LOG_LEVEL=info

# Arquivo de log
LOG_FILE=portalmcm.log

# Tamanho máximo do log antes de rotacionar (MB)
LOG_MAX_SIZE=10

################################################################################
# PERFORMANCE
################################################################################

# Cache geral (true, false)
CACHE_ENABLED=true

# Driver de cache (file, database, redis)
CACHE_DRIVER=file

# TTL padrão do cache (segundos)
CACHE_TTL=3600

# Compressão GZIP
GZIP_ENABLED=true

################################################################################
# DESENVOLVIMENTO
################################################################################

# Modo de desenvolvimento
DEV_MODE=false

# Exibir erros
DISPLAY_ERRORS=false

# Log de erros
LOG_ERRORS=true

# Profiling
ENABLE_PROFILING=false

################################################################################
# SERVIDOR
################################################################################

# Timezone
TIMEZONE=America/Sao_Paulo

# Locale
LOCALE=pt_BR.UTF-8

# Encoding
ENCODING=UTF-8

################################################################################
# INTEGRAÇÃO EXTERNA (OPCIONAL)
################################################################################

# Chaves de API externas
# GOOGLE_API_KEY=sua_chave
# AWS_ACCESS_KEY=sua_chave
# AWS_SECRET_KEY=sua_chave

################################################################################
# NOTAS IMPORTANTES
################################################################################

# 1. NUNCA commitar este arquivo em versão de controle
# 2. Ajustar valores conforme ambiente
# 3. Usar variáveis de ambiente do sistema em produção
# 4. Alterar APP_KEY e senhas em produção
# 5. Manter este arquivo seguro (permissões 600)
